# Variables lues automatiquement par docker compose.
# Copiez ce fichier en « .env » (même dossier que docker-compose.yml).

# Clé Google Gemini — narration TTS et illustration des scènes (facultative).
# Sans clé, la synthèse vocale du navigateur prend le relais et les scènes
# ne sont pas illustrées automatiquement.
# Obtenez-en une sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Illustration automatique des scènes ──────────────────────────────────
# À l'enregistrement d'une scène dans l'admin, son texte part vers Gemini,
# qui en écrit un prompt visuel puis génère l'image de fond.
# Mettre 0 pour ne garder que la génération manuelle
# (action de l'admin, ou : python manage.py generate_scene_images).
SCENE_IMAGE_AUTOGEN=1
# Backends d'image, essayés dans l'ordre (laisser vide = pollinations,gemini) :
#   pollinations = GRATUIT, sans clé, sans facturation — fonctionne tout de suite
#   gemini       = meilleure qualité, mais exige la facturation activée
#                  (le palier gratuit de l'API est à quota 0 sur les *-image)
SCENE_IMAGE_BACKEND=
SCENE_IMAGE_POLLINATIONS_MODEL=
# Modèles Gemini, essayés dans l'ordre (laisser vide = défauts du service)
SCENE_IMAGE_PROMPT_MODEL=
SCENE_IMAGE_MODEL=
SCENE_IMAGE_ASPECT_RATIO=16:9
# Direction artistique commune à toutes les scènes (laisser vide = défaut)
SCENE_IMAGE_STYLE=

# Hôtes autorisés. Pour jouer depuis un téléphone sur le même réseau,
# ajoutez l'IP LAN de votre PC, ex : localhost,127.0.0.1,0.0.0.0,192.168.1.20
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2

# Compte admin créé automatiquement au démarrage (facultatif).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
