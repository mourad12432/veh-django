# Variables lues automatiquement par docker compose.
# Copiez ce fichier en « .env » (même dossier que docker-compose.yml).

# Clé Google Gemini pour la narration TTS (facultative).
# Sans clé, la synthèse vocale du navigateur prend le relais.
# Obtenez-en une sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hôtes autorisés. Pour jouer depuis un téléphone sur le même réseau,
# ajoutez l'IP LAN de votre PC, ex : localhost,127.0.0.1,0.0.0.0,192.168.1.20
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2

# Compte admin créé automatiquement au démarrage (facultatif).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
